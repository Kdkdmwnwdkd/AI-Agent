<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 保留明文HTTP：本应用为本地运行的 Agent，需连接局域网/本地模型服务（ollama、llama.cpp 等明文HTTP）；
         仅移除用户证书（防止用户安装 CA 被用于中间人劫持 TLS），此为不破坏功能的净安全收益。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config> 