<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标图形的 drawable 引用别名。

  供应用内按 R.drawable.ic_launcher_simple_foreground 引用的场景
  （关于页 logo、聊天头像、消息卡片等）使用完整构图版本
  (drawable-nodpi/ic_app_logo.png)，而非自适应图标的前景层
  (mipmap-*/ic_launcher_simple_foreground.png)。

  原因：自适应图标的前景层按 Android 规范只占 108dp 画布中的 72dp 安全区，
  直接用于应用内显示会明显偏小并带大片透明边距。
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_app_logo"
    android:gravity="center" />
